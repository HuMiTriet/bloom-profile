[Unit]
Description=Unbound DNS Resolver (Experimental)
Documentation=man:unbound(8)
After=network.target

[Service]
# 1. Use Type=simple because you didn't compile with --enable-systemd
Type=simple

# 2. Point to the actual path where you installed it (/usr/local/sbin)
#    -d: Keep in foreground (required for systemd)
#    -c: Point to your config file
ExecStart=/usr/local/sbin/unbound -d -p -c /users/hmt/resolver.conf

# 3. Reload command
ExecReload=/bin/kill -HUP $MAINPID

# 4. Security & Permissions
# Run as the dedicated user we created
User=unbound
Group=unbound

# Allow binding to port 53 (privileged)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID CAP_SYS_RESOURCE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 5. Hardening (Relaxed for Experiment)
# We set ProtectHome=read-only (instead of true/yes) so it can read your config in ~/
ProtectHome=read-only
# We disable the strict system protection so you don't face "Read-only filesystem" errors during debugging
ProtectSystem=full 
PrivateTmp=true
PrivateDevices=true

# 6. Crash Recovery
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
